PROJECT_NAME=manzhushaka-next-scaff
PROJECT_TYPE=node-service
RUNTIME=node
RUNTIME_VERSION=22
HEALTHCHECK_URL=http://127.0.0.1:4000/api/health
PUBLIC_HEALTH_URL=https://manzhushaka.cn/gateway/manzhushaka-next-scaff/api/health
PUBLIC_ROUTE_VERIFIED=true
PUBLIC_ORIGIN=https://manzhushaka.cn/gateway/manzhushaka-next-scaff
PUBLIC_WEB_URL=https://manzhushaka.cn/gateway/manzhushaka-next-scaff/
PUBLIC_API_URL=https://manzhushaka.cn/gateway/manzhushaka-next-scaff/api
PUBLIC_API_HEALTH_URL=https://manzhushaka.cn/gateway/manzhushaka-next-scaff/api/health
JAVA_ARTIFACT=''
JAVA_LAYERED_RELEASE=false
NODE_ENTRY=dist/main.js
NODE_EXTRA_PATHS=''
MAX_RELEASE_ARCHIVE_MIB=150
RELEASE_REQUIRED_FILES='deploy/manzhushaka-next-scaff.locations.conf prisma/schema.prisma'
REMOTE_RUNTIME_PATH=/home/middleware/node/current/bin/node
REMOTE_REQUIRED_PATHS=''
REMOTE_REQUIRED_UNITS=personal-project@manzhushaka-next-scaff.service
REMOTE_NGINX_PATHS='/home/middleware/nginx/conf/conf.d/manzhushaka-next-scaff.locations.conf'
REMOTE_MIN_FREE_MIB=512
REQUIRE_APP_ENV=true
STATIC_DIR=dist
